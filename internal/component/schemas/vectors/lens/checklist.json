    {
      "name": "assignedMemberId becomes assigneePublicKey, up",
      "kind": "migrate",
      "steps": [
        {
          "to": 2,
          "breaking": false,
          "entries": {
            "^item_.+$": [
              {
                "op": "rename",
                "from": "assignedMemberId",
                "to": "assigneePublicKey"
              }
            ]
          }
        }
      ],
      "key": "item_a",
      "in": {
        "v": 1,
        "title": "Milk",
        "checked": false,
        "assignedMemberId": "pk-alice"
      },
      "to": 2,
      "out": {
        "v": 2,
        "title": "Milk",
        "checked": false,
        "assigneePublicKey": "pk-alice"
      },
      "lossy": false
    },
