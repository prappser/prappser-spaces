# =============================================================================
# Self-host stack configuration
# Copy this file to .env and fill in real values before running
# docker compose up -d
# =============================================================================

# Domain the server is reachable at. Caddy requests a Let's Encrypt cert for
# this domain and proxies it to the prappser-spaces container.
# Example: spaces.example.com
DOMAIN=

# Password for the Postgres user created in the postgres container.
POSTGRES_PASSWORD=

# LEGACY, optional. Only for a space created before the key moved onto the
# app_storage volume: set it once to migrate the old key, and keep it only if
# you may roll back to an older image. New installs leave it empty.
MASTER_PASSWORD=

# Comma-separated list of allowed CORS origins.
# Defaults to https://prappser.app if left empty.
ALLOWED_ORIGINS=

# Log level: debug, info, warn, or error. Defaults to info.
LOG_LEVEL=

# How often watchtower polls GHCR for a new image, in seconds. Defaults to 300.
WATCHTOWER_POLL_INTERVAL=

# Path to the docker config.json holding your GHCR login, mounted read-only
# into watchtower so it can pull the private image. Defaults to
# $HOME/.docker/config.json (Compose does plain string substitution, so a
# literal "~" would not expand here).
DOCKER_CONFIG_PATH=

# Cloudflare Tunnel token, only needed if running with
# docker-compose.cloudflare-tunnel.yml instead of exposing ports via Caddy.
# See docs/hosting/selfhost.md#cloudflare-variants.
CLOUDFLARE_TUNNEL_TOKEN=
